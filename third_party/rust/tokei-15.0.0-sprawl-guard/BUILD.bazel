# Crate Universe renders this file when it pins `cargo-bazel-lock.json`. This package
# builds the patched Tokei from the source here, which other workspaces can reach.

load(
    "@rules_rust//cargo:defs.bzl",
    "cargo_build_script",
    "cargo_toml_env_vars",
)
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

cargo_toml_env_vars(
    name = "cargo_toml_env_vars",
    src = "Cargo.toml",
)

rust_library(
    name = "tokei",
    srcs = glob(
        include = ["**/*.rs"],
        allow_empty = True,
    ),
    compile_data = glob(
        include = ["**"],
        allow_empty = True,
        exclude = [
            "**/* *",
            ".tmp_git_root/**/*",
            "BUILD",
            "BUILD.bazel",
            "WORKSPACE",
            "WORKSPACE.bazel",
        ],
    ),
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env_files = [
        ":cargo_toml_env_vars",
    ],
    rustc_flags = [
        "--cap-lints=allow",
    ],
    tags = [
        "cargo-bazel",
        "crate-name=tokei",
        "manual",
        "noclippy",
        "norustfmt",
    ],
    target_compatible_with = select({
        "@rules_rust//rust/platform:aarch64-apple-darwin": [],
        "@rules_rust//rust/platform:aarch64-unknown-linux-gnu": [],
        "@rules_rust//rust/platform:wasm32-unknown-unknown": [],
        "@rules_rust//rust/platform:wasm32-wasip1": [],
        "@rules_rust//rust/platform:x86_64-pc-windows-msvc": [],
        "@rules_rust//rust/platform:x86_64-unknown-linux-gnu": [],
        "@rules_rust//rust/platform:x86_64-unknown-nixos-gnu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    version = "15.0.0",
    deps = [
        ":build_script_build",
        "@sprawl_guard_crates__aho-corasick-1.1.5//:aho_corasick",
        "@sprawl_guard_crates__arbitrary-1.5.0//:arbitrary",
        "@sprawl_guard_crates__clap-cargo-0.18.3//:clap_cargo",
        "@sprawl_guard_crates__crossbeam-channel-0.5.17//:crossbeam_channel",
        "@sprawl_guard_crates__dashmap-6.2.1//:dashmap",
        "@sprawl_guard_crates__encoding_rs_io-0.1.8//:encoding_rs_io",
        "@sprawl_guard_crates__etcetera-0.11.0//:etcetera",
        "@sprawl_guard_crates__grep-searcher-0.1.17//:grep_searcher",
        "@sprawl_guard_crates__ignore-0.4.34//:ignore",
        "@sprawl_guard_crates__log-0.4.34//:log",
        "@sprawl_guard_crates__once_cell-1.21.4//:once_cell",
        "@sprawl_guard_crates__parking_lot-0.12.5//:parking_lot",
        "@sprawl_guard_crates__rayon-1.12.0//:rayon",
        "@sprawl_guard_crates__regex-1.13.1//:regex",
        "@sprawl_guard_crates__serde-1.0.229//:serde",
        "@sprawl_guard_crates__serde_json-1.0.154//:serde_json",
        "@sprawl_guard_crates__table_formatter-0.6.1//:table_formatter",
        "@sprawl_guard_crates__term_size-0.3.2//:term_size",
        "@sprawl_guard_crates__toml-0.9.12-spec-1.1.0//:toml",
    ],
)

cargo_build_script(
    name = "_bs",
    srcs = glob(
        include = ["**/*.rs"],
        allow_empty = True,
    ),
    build_script_env_files = [
        ":cargo_toml_env_vars",
    ],
    compile_data = glob(
        include = ["**"],
        allow_empty = True,
        exclude = [
            "**/* *",
            "**/*.rs",
            ".tmp_git_root/**/*",
            "BUILD",
            "BUILD.bazel",
            "WORKSPACE",
            "WORKSPACE.bazel",
        ],
    ),
    crate_name = "build_script_build",
    crate_root = "build.rs",
    data = glob(
        include = ["**"],
        allow_empty = True,
        exclude = [
            "**/* *",
            ".tmp_git_root/**/*",
            "BUILD",
            "BUILD.bazel",
            "WORKSPACE",
            "WORKSPACE.bazel",
        ],
    ),
    edition = "2021",
    emit_warnings = False,
    pkg_name = "tokei",
    rustc_env_files = [
        ":cargo_toml_env_vars",
    ],
    rustc_flags = [
        "--cap-lints=allow",
    ],
    tags = [
        "cargo-bazel",
        "crate-name=tokei",
        "manual",
        "noclippy",
        "norustfmt",
    ],
    version = "15.0.0",
    visibility = ["//visibility:private"],
    deps = [
        "@sprawl_guard_crates__ignore-0.4.34//:ignore",
        "@sprawl_guard_crates__json5-0.4.1//:json5",
        "@sprawl_guard_crates__serde_json-1.0.154//:serde_json",
        "@sprawl_guard_crates__tera-1.20.1//:tera",
    ],
)

alias(
    name = "build_script_build",
    actual = ":_bs",
    tags = ["manual"],
)
