"""Builds the sprawl-guard CLI and library with Bazel."""

module(name = "sprawl_guard")

bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.100.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "sprawl_guard_crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = [
        "//:Cargo.toml",
        "//crates/sprawl-guard:Cargo.toml",
        "//crates/sprawl-guard-lib:Cargo.toml",
    ],
)

# The patched Tokei builds from this repository and depends on these crates directly.
# BEGIN TOKEI DEPENDENCIES
use_repo(
    crate,
    "sprawl_guard_crates",
    "sprawl_guard_crates__aho-corasick-1.1.5",
    "sprawl_guard_crates__arbitrary-1.5.0",
    "sprawl_guard_crates__clap-cargo-0.18.3",
    "sprawl_guard_crates__crossbeam-channel-0.5.17",
    "sprawl_guard_crates__dashmap-6.2.1",
    "sprawl_guard_crates__encoding_rs_io-0.1.8",
    "sprawl_guard_crates__etcetera-0.11.0",
    "sprawl_guard_crates__grep-searcher-0.1.17",
    "sprawl_guard_crates__ignore-0.4.34",
    "sprawl_guard_crates__json5-0.4.1",
    "sprawl_guard_crates__log-0.4.34",
    "sprawl_guard_crates__once_cell-1.21.4",
    "sprawl_guard_crates__parking_lot-0.12.5",
    "sprawl_guard_crates__rayon-1.12.0",
    "sprawl_guard_crates__regex-1.13.1",
    "sprawl_guard_crates__serde-1.0.229",
    "sprawl_guard_crates__serde_json-1.0.154",
    "sprawl_guard_crates__table_formatter-0.6.1",
    "sprawl_guard_crates__tera-1.20.1",
    "sprawl_guard_crates__term_size-0.3.2",
    "sprawl_guard_crates__toml-0.9.12-spec-1.1.0",
)
