{
  "name": "@kpozin/sprawl-guard-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test && astro check && pnpm run build",
    "dev": "astro dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.3",
    "acorn": "8.17.0",
    "astro": "7.1.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "satteri": "0.9.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/mdast": "4.0.4",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0"
}
