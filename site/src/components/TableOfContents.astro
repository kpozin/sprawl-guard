---
/**
 * Adds a link to the current page's Markdown version below the page's table of contents, so
 * readers can hand the page to a coding agent. It reuses the alternate link that the route
 * middleware adds to the page head, and adds nothing on pages without one.
 */
import DefaultTableOfContents from "@astrojs/starlight/components/TableOfContents.astro";

const markdownHref = Astro.locals.starlightRoute.head.find(
  ({ tag, attrs }) => tag === "link" && attrs?.rel === "alternate" && attrs.type === "text/markdown",
)?.attrs?.href;
---

<DefaultTableOfContents />
{
  typeof markdownHref === "string" && (
    <a href={markdownHref} class="markdown-link">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24">
        <rect
          x="0.5"
          y="3.5"
          width="23"
          height="17"
          rx="3"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
        <text
          x="12"
          y="16.25"
          text-anchor="middle"
          fill="currentColor"
          font-size="11"
          font-weight="800"
          letter-spacing="-0.5"
          font-family="system-ui, sans-serif"
        >
          MD
        </text>
      </svg>
      View as Markdown
    </a>
  )
}

<style>
  @layer starlight.components {
    .markdown-link {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      margin-block-start: 1rem;
      padding-block-start: 1rem;
      border-block-start: 1px solid var(--sl-color-hairline);
    }
    svg {
      flex-shrink: 0;
      width: 1.25em;
      height: 1.25em;
    }
  }
</style>
