---
import {
  findCliReferenceCommand,
  formatCliReferenceError,
  inlineCodeSegments,
} from "../markdown/cli-reference";

interface Props {
  path: string;
}

const { path } = Astro.props;
const commandResult = findCliReferenceCommand(path);
if (!commandResult.ok) throw new Error(formatCliReferenceError(commandResult.error));
const command = commandResult.value;
---

<p><code>{command.usage}</code></p>

<table>
  <thead>
    <tr>
      <th>Argument or option</th>
      <th>Meaning</th>
    </tr>
  </thead>
  <tbody>
    {
      command.arguments.map((argument) => {
        return (
          <tr>
            <td><code>{argument.syntax}</code></td>
            <td>
              {
                argument.help === null
                  ? ""
                  : inlineCodeSegments(argument.help).map((segment) =>
                      segment.kind === "code" ? <code>{segment.value}</code> : segment.value,
                    )
              }
              {
                argument.default_values.length > 0 && (
                  <div>
                    <strong>Default:</strong> <code>{argument.default_values.join(" ")}</code>
                  </div>
                )
              }
              {
                argument.conflicts_with.length > 0 && (
                  <div>
                    <strong>Conflicts with:</strong>{" "}
                    <code>{argument.conflicts_with.join(", ")}</code>
                  </div>
                )
              }
              {
                argument.possible_values.length > 0 && (
                  <div>
                    <strong>Allowed values:</strong>
                    <ul>
                      {
                        argument.possible_values.map((value) => (
                          <li>
                            <code>{value.name}</code>
                            {
                              value.help === null
                                ? ""
                                : [
                                    " — ",
                                    ...inlineCodeSegments(value.help).map((segment) =>
                                      segment.kind === "code" ? (
                                        <code>{segment.value}</code>
                                      ) : (
                                        segment.value
                                      ),
                                    ),
                                  ]
                            }
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                )
              }
            </td>
          </tr>
        );
      })
    }
  </tbody>
</table>
