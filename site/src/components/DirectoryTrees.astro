---
/**
 * The homepage's two file explorers, beside the text passed as children: the same files crowded
 * into one directory, then grouped by feature. The flat explorer is cropped and faded at the bottom
 * to show that it keeps going.
 */
import flatTree from "../assets/directory-tree-flat.svg";
import organizedTree from "../assets/directory-tree-organized.svg";
---

<div class="beside-directory-trees">
  <div class="directory-trees">
    <figure class="flat">
      <div class="window">
        <img
          src={flatTree.src}
          width={flatTree.width}
          height={flatTree.height}
          alt="An editor's file explorer with 40 files directly inside src, continuing past the bottom of the window."
        />
      </div>
      <figcaption>One directory, 40 files</figcaption>
    </figure>
    <figure class="organized">
      <div class="window">
        <img
          src={organizedTree.src}
          width={organizedTree.width}
          height={organizedTree.height}
          alt="The same files grouped into api, auth, billing, customers, db, notifications, payments, and reports directories, with three files left directly inside src."
        />
      </div>
      <figcaption>The same files, grouped by feature</figcaption>
    </figure>
  </div>
  <slot />
</div>

<style define:vars={{ organizedAspectRatio: `${organizedTree.width} / ${organizedTree.height}` }}>
  /* Narrow screens: a compact comparison below the text. */
  .beside-directory-trees {
    display: flex;
    flex-direction: column;
  }
  .directory-trees {
    order: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 340px));
    justify-content: center;
    align-items: start;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .beside-directory-trees > :global(:not(.directory-trees)) {
    order: 2;
  }
  .beside-directory-trees > :global(p:first-of-type) {
    order: 0;
  }
  figure {
    width: min(100%, 340px);
    margin: 0;
  }
  .window {
    /* Both explorers are as tall as the organized one, which crops the longer flat one. */
    aspect-ratio: var(--organizedAspectRatio);
    overflow: hidden;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  .flat .window {
    mask-image: linear-gradient(to bottom, black 60%, transparent);
  }
  figcaption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  /* Medium screens: more space between the explorers. */
  @media (min-width: 50rem) {
    .directory-trees {
      gap: 2rem;
    }
  }
  /* Wide screens: the explorers to the left of the text. */
  @media (min-width: 72rem) {
    .beside-directory-trees {
      display: flow-root;
    }
    .directory-trees {
      float: left;
      gap: 1rem;
      margin: 0 2rem 1rem 0;
    }
  }
</style>
